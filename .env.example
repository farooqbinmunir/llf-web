# Base URL of the Strapi CMS (the llf repo), without a trailing slash.
STRAPI_URL=http://localhost:1337
# Public base URL of this site, without a trailing slash. Share links and absolute URLs are built from it.
SITE_URL=http://localhost:3000
# Lets the enquiry and newsletter forms store submissions in Strapi. Run `npm run token:forms` in llf to create it.
STRAPI_FORMS_TOKEN=
